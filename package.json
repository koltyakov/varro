{
  "name": "varro",
  "displayName": "Varro: OpenCode Workbench",
  "version": "0.32.10",
  "description": "OpenCode agent workbench with project-aware chat, parallel sessions, plan and change review, model and permission controls, commit messages, and usage insights.",
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "agentic-coding",
    "ai",
    "chat",
    "coding-agent",
    "commit-message",
    "opencode",
    "opencode-gui"
  ],
  "homepage": "https://github.com/koltyakov/varro#readme",
  "bugs": {
    "url": "https://github.com/koltyakov/varro/issues"
  },
  "license": "MIT",
  "repository": "https://github.com/koltyakov/varro",
  "publisher": "koltyakov",
  "files": [
    "dist/extension/extension.js",
    "dist/extension/thumbnail-worker.js",
    "dist/extension/thumbnail-service.js",
    "dist/extension/thumbnail-codec.wasm",
    "dist/extension/thumbnail-LICENSE.txt",
    "dist/extension/thumbnail-NOTICE.txt",
    "dist/extension/notification.wav",
    "dist/extension/macos-notifier.zip",
    "dist/extension/macos-notifier.json",
    "native/macos-notifications",
    "docs/thumbnail-distribution.md",
    "dist/webview",
    "assets/icon.png",
    "README.md",
    "CHANGELOG.md",
    "NOTICES.md",
    "LICENSE"
  ],
  "main": "./dist/extension/extension.js",
  "scripts": {
    "postinstall": "node scripts/build-anti-slop-plugin.mjs",
    "build:extension": "node esbuild.config.mjs",
    "build:notifications:macos": "node scripts/build-macos-notifier.mjs",
    "test:notifications:macos": "node --test scripts/macos-notifier.test.mjs",
    "build:webview": "vite build",
    "preview:webview": "vite --open /preview.html",
    "build": "npm run build:extension && npm run build:webview",
    "watch:extension": "node esbuild.config.mjs --watch",
    "watch:webview": "vite build --watch",
    "dev": "npx concurrently --kill-others-on-fail --names ext,web,preview \"npm run watch:extension\" \"npm run watch:webview\" \"npm run preview:webview\"",
    "lint": "oxlint -c oxlint.config.mts --type-aware . --fix",
    "lint:check": "oxlint -c oxlint.config.mts --type-aware .",
    "fmt": "oxfmt src/",
    "fmt:check": "oxfmt --check src/",
    "test": "node scripts/run-tests.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:scripts:browser": "node --test scripts/browser/*.test.mjs",
    "test:compatibility": "node scripts/opencode-compatibility/run.mjs --check-floor --report artifacts/opencode-compatibility.json --summary scripts/opencode-compatibility/verified.json",
    "test:compatibility:adapters": "node scripts/opencode-compatibility/run-adapters.mjs",
    "test:compatibility:ui": "npm run build && node scripts/opencode-compatibility/run-ui.mjs",
    "compatibility:discover": "node scripts/opencode-compatibility/run.mjs --report artifacts/opencode-compatibility.json",
    "pretest:e2e": "playwright install chromium",
    "test:e2e": "node scripts/run-e2e.mjs",
    "pretest:e2e:raster": "playwright install chromium",
    "test:e2e:raster": "VARRO_E2E_MODE=raster node scripts/run-e2e.mjs",
    "pretest:e2e:diagnostics": "playwright install chromium",
    "test:e2e:diagnostics": "VARRO_E2E_MODE=diagnostics node scripts/run-e2e.mjs",
    "test:vscode-sandbox": "npm run build && node scripts/vscode-sandbox/run.mjs",
    "ai:vscode": "npm run build && node scripts/launch-ai-vscode.mjs",
    "ai:preconditions": "node scripts/ai-fuzzy-preconditions.mjs",
    "ai:live": "node scripts/ai-fuzzy-live.mjs",
    "ai:playback": "node scripts/ai-session-playback.mjs",
    "ai:streaming": "node scripts/ai-streaming.mjs",
    "test:ai-runner": "npm run build && node scripts/ai-streaming-smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json",
    "typecheck:suggestions": "node scripts/check-ts-suggestions.mjs",
    "package:vsix": "node scripts/package-vsix.mjs",
    "package": "npm run build && npm run package:vsix",
    "vscode:install": "node scripts/vscode-install.mjs",
    "artifacts:prune": "node scripts/prune-artifacts.mjs"
  },
  "dependencies": {
    "@imagemagick/magick-wasm": "0.0.44",
    "@opencode-ai/sdk": "^1.18.35",
    "@opencode/client": "^2.0.26",
    "cross-spawn": "7.0.6",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "jsonc-parser": "3.3.1",
    "marked": "18.1.0",
    "mermaid": "^12.1.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/css.escape": "1.5.2",
    "@types/node": "26.6.5",
    "@types/vscode": "1.120.0",
    "@vitest/coverage-v8": "5.0.3",
    "@vscode/vsce": "4.0.0",
    "css.escape": "1.5.1",
    "esbuild": "0.28.2",
    "iconoir": "7.12.1",
    "jsdom": "30.1.2",
    "material-icon-theme": "5.39.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-plugin-anti-slop": "github:dmmulroy/anti-slop#c44ef22",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  },
  "overrides": {
    "mermaid": {
      "katex": "0.19.0"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "varro-primary",
          "title": "Varro",
          "icon": "assets/icon.png"
        }
      ],
      "secondarySidebar": [
        {
          "id": "varro",
          "title": "Varro",
          "icon": "assets/icon.png"
        }
      ]
    },
    "views": {
      "varro": [
        {
          "icon": "assets/icon.png",
          "type": "webview",
          "id": "varro.chat",
          "name": "Varro"
        }
      ]
    },
    "commands": [
      {
        "command": "varro.chat.newSession",
        "title": "Varro: New Session"
      },
      {
        "command": "varro.chat.newEditor",
        "title": "Varro: New Chat Editor",
        "shortTitle": "New Chat Editor",
        "icon": "$(add)"
      },
      {
        "command": "varro.chat.newWindow",
        "title": "Varro: New Chat Window",
        "shortTitle": "New Chat Window"
      },
      {
        "command": "varro.chat.newTerminalEditor",
        "title": "Varro: New Terminal Editor",
        "shortTitle": "New Terminal Editor",
        "icon": "$(terminal)"
      },
      {
        "command": "varro.chat.searchSessions",
        "title": "Varro: Search Sessions"
      },
      {
        "command": "varro.chat.openSettings",
        "title": "Varro: Open Settings",
        "shortTitle": "Settings",
        "icon": "$(gear)"
      },
      {
        "command": "varro.chat.showFileDiffs",
        "title": "Varro: Show File Diffs",
        "shortTitle": "Show File Diffs",
        "icon": "$(diff-single)"
      },
      {
        "command": "varro.chat.hideFileDiffs",
        "title": "Varro: Hide File Diffs",
        "shortTitle": "Hide File Diffs",
        "icon": "$(list-flat)"
      },
      {
        "command": "varro.chat.openStats",
        "title": "Varro: Usage Stats",
        "shortTitle": "Usage Stats"
      },
      {
        "command": "varro.chat.abort",
        "title": "Varro: Abort Session",
        "enablement": "varro:canAbortSession"
      },
      {
        "command": "varro.chat.previousSession",
        "title": "Varro: Previous Session",
        "enablement": "varro:canSwitchSessions"
      },
      {
        "command": "varro.chat.nextSession",
        "title": "Varro: Next Session",
        "enablement": "varro:canSwitchSessions"
      },
      {
        "command": "varro.server.restart",
        "title": "Varro: Restart Server"
      },
      {
        "command": "varro.about",
        "title": "Varro: About",
        "shortTitle": "About Varro"
      },
      {
        "command": "varro.openGitHub",
        "title": "Varro: Open GitHub",
        "shortTitle": "View on GitHub"
      },
      {
        "command": "varro.showOutput",
        "title": "Varro: Show Output"
      },
      {
        "command": "varro.openSourceControl",
        "title": "Varro: Open Source Control"
      },
      {
        "command": "varro.generateCommitMessage",
        "title": "Varro: Generate Commit Message",
        "icon": "$(wand)"
      },
      {
        "command": "varro.agents.openGlobal",
        "title": "Varro: Open Global AGENTS.md"
      },
      {
        "command": "varro.agents.initializeProject",
        "title": "Varro: Initialize Project AGENTS.md"
      },
      {
        "command": "varro.chat.addToContext",
        "title": "Varro: Add to Context"
      },
      {
        "command": "varro.chat.addProblemsToContext",
        "title": "Varro: Add to Context",
        "enablement": "config.varro.chat.enableProblemsContext"
      },
      {
        "command": "varro.chat.addSelectionToContext",
        "title": "Varro: Add to Context"
      },
      {
        "command": "varro.chat.addTerminalSelectionToContext",
        "title": "Varro: Add to Context"
      },
      {
        "command": "varro.chat.copyLinkText",
        "title": "Copy"
      },
      {
        "command": "varro.chat.copyLink",
        "title": "Copy link"
      },
      {
        "command": "varro.chat.copyPath",
        "title": "Copy path"
      }
    ],
    "submenus": [
      {
        "id": "varro.viewActions",
        "label": "More Actions",
        "icon": "$(more)"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "varro.chat.copyLinkText",
          "when": "(webviewId == varro.chat || webviewId == varro.editor) && varroLinkText",
          "group": "navigation@0"
        },
        {
          "command": "varro.chat.copyLink",
          "when": "(webviewId == varro.chat || webviewId == varro.editor) && webviewSection == varroExternalLink",
          "group": "navigation@1"
        },
        {
          "command": "varro.chat.copyPath",
          "when": "(webviewId == varro.chat || webviewId == varro.editor) && webviewSection == varroFileLink",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "varro.chat.newEditor",
          "when": "activeWebviewPanelId == varro.editor",
          "group": "navigation@1"
        },
        {
          "command": "varro.chat.newTerminalEditor",
          "when": "activeWebviewPanelId == varro.editor",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "varro.chat.addToContext",
          "group": "z_varro"
        }
      ],
      "editor/context": [
        {
          "command": "varro.chat.addSelectionToContext",
          "when": "editorHasSelection && !editorReadonly",
          "group": "z_varro"
        }
      ],
      "terminal/context": [
        {
          "command": "varro.chat.addTerminalSelectionToContext",
          "when": "terminalTextSelected",
          "group": "z_varro"
        }
      ],
      "scm/title": [
        {
          "command": "varro.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation@99"
        }
      ],
      "view/title": [
        {
          "command": "varro.chat.showFileDiffs",
          "when": "view == varro.chat && !varro:showFileDiffs",
          "group": "navigation@0"
        },
        {
          "command": "varro.chat.hideFileDiffs",
          "when": "view == varro.chat && varro:showFileDiffs",
          "group": "navigation@0"
        },
        {
          "command": "varro.chat.openSettings",
          "when": "view == varro.chat",
          "group": "navigation@1"
        },
        {
          "submenu": "varro.viewActions",
          "when": "view == varro.chat",
          "group": "navigation@2"
        }
      ],
      "varro.viewActions": [
        {
          "command": "varro.about",
          "group": "1_main@1"
        },
        {
          "command": "varro.chat.openStats",
          "group": "1_main@2"
        },
        {
          "command": "varro.openGitHub",
          "group": "1_main@3"
        }
      ],
      "commandPalette": [
        {
          "command": "varro.chat.copyLinkText",
          "when": "false"
        },
        {
          "command": "varro.chat.copyLink",
          "when": "false"
        },
        {
          "command": "varro.chat.copyPath",
          "when": "false"
        },
        {
          "command": "varro.chat.addProblemsToContext",
          "when": "false"
        },
        {
          "command": "varro.chat.showFileDiffs",
          "when": "!varro:showFileDiffs"
        },
        {
          "command": "varro.chat.hideFileDiffs",
          "when": "varro:showFileDiffs"
        },
        {
          "command": "varro.chat.addToContext",
          "when": "editorIsOpen"
        },
        {
          "command": "varro.chat.addSelectionToContext",
          "when": "false"
        },
        {
          "command": "varro.chat.addTerminalSelectionToContext",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "varro.chat.addSelectionToContext",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "varro.chat.addToContext",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "!terminalFocus && !editorTextFocus"
      },
      {
        "command": "varro.chat.addTerminalSelectionToContext",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "terminalFocus && terminalTextSelected"
      }
    ],
    "configuration": {
      "title": "Varro",
      "properties": {
        "varro.notifications.sound": {
          "type": "object",
          "scope": "application",
          "additionalProperties": false,
          "properties": {
            "permission": {
              "type": "boolean",
              "description": "Permission requests, including requests from subagents.",
              "default": false
            },
            "question": {
              "type": "boolean",
              "description": "Questions that need your answer.",
              "default": false
            },
            "completed": {
              "type": "boolean",
              "description": "Completed replies in non-plan conversations.",
              "default": false
            },
            "planReady": {
              "type": "boolean",
              "description": "Plans ready for review.",
              "default": false
            }
          },
          "default": {
            "permission": false,
            "question": false,
            "completed": false,
            "planReady": false
          },
          "markdownDescription": "Choose which events play the water-plop sound when VS Code is in the background. On macOS, sound stays off while an editor window is still visible, including side-by-side use. Leave all events unchecked to disable sound. Requires a local desktop extension host. On Linux, install `paplay`, `aplay`, or `canberra-gtk-play`."
        },
        "varro.notifications.native": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "markdownDescription": "Show operating-system notifications for completed replies, plans ready for review, permission requests, and questions when VS Code is in the background. On macOS, notifications stay off while an editor window is still visible, including side-by-side use. Sound is controlled separately by `varro.notifications.sound`. Requires a local desktop extension host and OS notification permissions. On Linux, install `notify-send`."
        },
        "varro.server.port": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "auto"
              ]
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          ],
          "default": "auto",
          "markdownDescription": "Automatically select and remember a local server port, or set an exact port from 1 through 65535. Existing verified servers are reused without restarting. Explicit ports never fall back to another port. Reload the VS Code window after changing this setting."
        },
        "varro.server.command": {
          "type": "string",
          "default": "",
          "description": "Optional path to the OpenCode CLI executable used for startup and CLI actions. OpenCode v2 is recommended; v1 remains supported. When empty, Varro searches for opencode2 first, then opencode. Both current CLI families use opencode. Set an explicit v1 executable path to keep using v1."
        },
        "varro.server.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically install updates within the installed OpenCode CLI family: @opencode/cli for v2 on Windows, macOS, and Linux; opencode-ai for v1 on macOS and Linux. Does not migrate v1 to v2. Native Windows v1 uses an update prompt."
        },
        "varro.chat.showFileDiffs": {
          "type": "boolean",
          "default": false,
          "description": "Show line-by-line edits directly in file-change tool cards."
        },
        "varro.chat.expandThinking": {
          "type": "boolean",
          "default": false,
          "description": "Expand thinking details after two seconds while reasoning is active, collapse finished thinking into rows, and return it to Explored when the turn finishes."
        },
        "varro.chat.fontSize": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 6,
          "maximum": 100,
          "default": null,
          "markdownDescription": "Font size for text in Varro chat. Set to `null` to use the VS Code `chat.fontSize` setting, or use `13.5` for text slightly larger than the default."
        },
        "varro.chat.showChangedFiles": {
          "type": "boolean",
          "default": false,
          "description": "Show the changed-files panel above the chat input."
        },
        "varro.chat.enableProblemsContext": {
          "type": "boolean",
          "default": true,
          "description": "Enable VS Code Problems context in chat. Disable to hide the Problems attachment chip and exclude diagnostics from prompts, including queued messages."
        },
        "varro.chat.showTurnTimer": {
          "type": "boolean",
          "default": true,
          "description": "Show the elapsed duration of the active turn beside the chat input status controls."
        },
        "varro.chat.desktopSessionPaneSide": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "right",
          "markdownDescription": "Choose which side shows the sessions pane on large screens in the Varro chat view."
        },
        "varro.chat.defaultPermissionMode": {
          "type": "string",
          "enum": [
            "default",
            "auto",
            "full"
          ],
          "default": "auto",
          "markdownDescription": "Permission mode selected when no project or global Varro permission-mode selection has been saved. `default` follows OpenCode permission settings and shows requests OpenCode asks about, `auto` judges eligible requests automatically, and `full` grants unrestricted access."
        },
        "varro.chat.autoApproveModel": {
          "type": "string",
          "scope": "application",
          "default": "",
          "pattern": "^$|^[^/\\s]+/[^\\s]+$",
          "patternErrorMessage": "Use provider/model, or leave the setting empty.",
          "markdownDescription": "Provider/model used by the auto-approve judge. Leave empty to let Varro select a suitable model automatically. Select a configured model from Varro's Models view."
        },
        "varro.chat.autoRenameUntitledSessions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Let Varro generate a fallback title when OpenCode leaves a session untitled. Disable this to rely only on OpenCode's native session naming."
        },
        "varro.commitMessage.model": {
          "type": "string",
          "scope": "application",
          "default": "",
          "pattern": "^$|^[^/\\s]+/[^\\s]+$",
          "patternErrorMessage": "Use provider/model, or leave the setting empty.",
          "markdownDescription": "Provider/model used to generate commit messages. Leave empty to let Varro select a suitable model automatically. Select a configured model from Varro's Models view."
        },
        "varro.decisions.jev.autoApprove": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "markdownDescription": "Use TypeSafe's Jev to judge permission requests in Auto mode before the model judge. Only confident answers approve; anything else asks you. Connect it with **Add decision model** in the Varro Models view menu, or set `TYPESAFE_API_KEY`. Permission details are sent to TypeSafe."
        },
        "varro.debug.simulateMissingCli": {
          "deprecationMessage": "Debug only setting. Not intended for regular use.",
          "type": "boolean",
          "default": false,
          "description": "Debug only: make Varro behave as if the OpenCode CLI is not installed"
        },
        "varro.debug.simulateNoProviders": {
          "deprecationMessage": "Debug only setting. Not intended for regular use.",
          "type": "boolean",
          "default": false,
          "description": "Debug only: make Varro behave as if no providers are configured"
        },
        "varro.debug.showQuotaWarning": {
          "deprecationMessage": "Debug only setting. Not intended for regular use.",
          "type": "boolean",
          "default": false,
          "description": "Debug only: show the quota warning for available provider quotas regardless of remaining allowance or saved dismissals. Closing this preview does not save a dismissal."
        },
        "varro.debug.resetWarningDays": {
          "deprecationMessage": "Debug only setting. Not intended for regular use.",
          "type": "number",
          "minimum": 5,
          "default": 5,
          "description": "Debug only: days before a usage reset expires to show its warning. Increase this to preview resets expiring later. Saved dismissals still apply unless debug.showQuotaWarning is enabled."
        },
        "varro.debug.simulateUpgradeFailure": {
          "deprecationMessage": "Debug only setting. Not intended for regular use.",
          "type": "string",
          "default": "",
          "description": "Debug only: make OpenCode CLI updates fail with this error text, to exercise the update recovery guidance (for example \"EPERM: operation not permitted\")"
        },
        "varro.server.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the OpenCode server when Varro first needs it. Disable for attach-only connections to a manually managed, Docker, or tunneled server; local CLI and file-based server configuration actions are unavailable in this mode."
        }
      }
    }
  },
  "activationEvents": [
    "onCommand:varro.chat.focus",
    "onCommand:varro.chat.statusBarClick",
    "onUri",
    "onWebviewPanel:varro.editor"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#232323",
    "theme": "dark"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "vscode": "^1.120.0"
  },
  "volta": {
    "node": "24.21.0",
    "npm": "10.9.9"
  },
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Varro starts a local OpenCode process and grants it access to the workspace."
    }
  }
}

{
  "name": "varro",
  "displayName": "Varro: OpenCode Workbench",
  "version": "0.38.1",
  "description": "OpenCode agent workbench with project-aware chat, parallel sessions, plan and change review, model and permission controls, commit messages, and usage insights.",
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "agentic-coding",
    "ai",
    "chat",
    "coding-agent",
    "commit-message",
    "opencode",
    "opencode-gui"
  ],
  "homepage": "https://github.com/koltyakov/varro#readme",
  "bugs": {
    "url": "https://github.com/koltyakov/varro/issues"
  },
  "license": "MIT",
  "repository": "https://github.com/koltyakov/varro",
  "publisher": "koltyakov",
  "files": [
    "dist/extension/extension.js",
    "dist/extension/thumbnail-worker.js",
    "dist/extension/thumbnail-service.js",
    "dist/extension/thumbnail-codec.wasm",
    "dist/extension/thumbnail-LICENSE.txt",
    "dist/extension/thumbnail-NOTICE.txt",
    "dist/extension/notification.wav",
    "dist/extension/macos-notifier.zip",
    "dist/extension/macos-notifier.json",
    "native/macos-notifications",
    "docs/thumbnail-distribution.md",
    "dist/webview",
    "assets/icon.png",
    "assets/workbench-icon.svg",
    "README.md",
    "CHANGELOG.md",
    "NOTICES.md",
    "LICENSE"
  ],
  "main": "./dist/extension/extension.js",
  "scripts": {
    "postinstall": "node scripts/build-anti-slop-plugin.mjs",
    "build:extension": "node esbuild.config.mjs",
    "build:notifications:macos": "node scripts/build-macos-notifier.mjs",
    "test:notifications:macos": "node --test scripts/macos-notifier.test.mjs",
    "build:webview": "vite build",
    "preview:webview": "vite --open /preview.html",
    "build": "npm run build:extension && npm run build:webview",
    "watch:extension": "node esbuild.config.mjs --watch",
    "watch:webview": "vite build --watch",
    "dev": "npx concurrently --kill-others-on-fail --names ext,web,preview \"npm run watch:extension\" \"npm run watch:webview\" \"npm run preview:webview\"",
    "lint": "oxlint -c oxlint.config.mts --type-aware . --fix",
    "lint:check": "oxlint -c oxlint.config.mts --type-aware .",
    "fmt": "oxfmt src/",
    "fmt:check": "oxfmt --check src/",
    "test": "node scripts/run-tests.mjs",
    "test:scripts": "node scripts/run-tests.mjs --scripts",
    "test:scripts:browser": "node --test scripts/browser/*.test.mjs",
    "test:compatibility": "node scripts/opencode-compatibility/run.mjs --check-floor --report artifacts/opencode-compatibility.json --summary scripts/opencode-compatibility/verified.json",
    "test:compatibility:adapters": "node scripts/opencode-compatibility/run-adapters.mjs",
    "test:compatibility:ui": "npm run build && node scripts/opencode-compatibility/run-ui.mjs",
    "compatibility:discover": "node scripts/opencode-compatibility/run.mjs --report artifacts/opencode-compatibility.json",
    "pretest:e2e": "playwright install chromium",
    "test:e2e": "node scripts/run-e2e.mjs",
    "pretest:e2e:raster": "playwright install chromium",
    "test:e2e:raster": "VARRO_E2E_MODE=raster node scripts/run-e2e.mjs",
    "pretest:e2e:diagnostics": "playwright install chromium",
    "test:e2e:diagnostics": "VARRO_E2E_MODE=diagnostics node scripts/run-e2e.mjs",
    "test:vscode-sandbox": "npm run build && node scripts/vscode-sandbox/run.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json",
    "typecheck:suggestions": "node scripts/check-ts-suggestions.mjs",
    "package:vsix": "node scripts/package-vsix.mjs",
    "package": "npm run build && npm run package:vsix",
    "vscode:install": "node scripts/vscode-install.mjs",
    "artifacts:prune": "node scripts/prune-artifacts.mjs"
  },
  "dependencies": {
    "@imagemagick/magick-wasm": "0.0.46",
    "@opencode-ai/sdk": "^1.19.6",
    "@opencode/client": "^2.4.2",
    "@solidjs/signals": "2.0.4",
    "@solidjs/web": "2.0.4",
    "cross-spawn": "7.0.6",
    "dompurify": "3.5.0",
    "highlight.js": "11.12.0",
    "jsonc-parser": "3.3.1",
    "katex": "0.19.1",
    "marked": "18.3.0",
    "mermaid": "^12.4.0",
    "solid-js": "2.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@solidjs/vite-plugin": "3.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/css.escape": "1.5.2",
    "@types/node": "26.6.11",
    "@types/vscode": "1.107.0",
    "@vitest/coverage-v8": "5.1.2",
    "@vscode/vsce": "4.1.1",
    "css.escape": "1.5.1",
    "esbuild": "0.28.2",
    "iconoir": "7.12.2",
    "jsdom": "31.0.1",
    "material-icon-theme": "5.40.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-plugin-anti-slop": "github:dmmulroy/anti-slop#63dbb09",
    "oxlint-tsgolint": "7.0.2009",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "ws": "8.23.1"
  },
  "overrides": {
    "@azure/identity": {
      "@azure/msal-node": "7.2.3"
    },
    "@vscode/vsce": {
      "minimatch": "11.0.9"
    },
    "mermaid": {
      "katex": "0.19.1"
    }
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "varro",
          "title": "Varro",
          "icon": "assets/workbench-icon.svg"
        }
      ],
      "activitybar": [
        {
          "id": "varro-primary",
          "title": "Varro",
          "icon": "assets/workbench-icon.svg"
        },
        {
          "id": "varro",
          "title": "Varro",
          "icon": "assets/workbench-icon.svg"
        }
      ]
    },
    "views": {
      "varro": [
        {
          "icon": "assets/workbench-icon.svg",
          "type": "webview",
          "id": "varro.chat",
          "name": "Varro"
        }
      ]
    },
    "commands": [
      {
        "command": "varro.chat.focusInput",
        "title": "Varro: Focus Chat"
      },
      {
        "command": "varro.chat.newSession",
        "title": "Varro: New Session"
      },
      {
        "command": "varro.chat.newEditor",
        "title": "Varro: New Chat Editor",
        "shortTitle": "New Chat Editor",
        "icon": "$(add)"
      },
      {
        "command": "varro.chat.newWindow",
        "title": "Varro: New Chat Window",
        "shortTitle": "New Chat Window"
      },
      {
        "command": "varro.chat.newTerminalEditor",
        "title": "Varro: New Terminal Editor",
        "shortTitle": "New Terminal Editor",
        "icon": "$(terminal)"
      },
      {
        "command": "varro.chat.searchSessions",
        "title": "Varro: Search Sessions"
      },
      {
        "command": "varro.chat.openSettings",
        "title": "Varro: Open Settings",
        "shortTitle": "Settings",
        "icon": "$(gear)"
      },
      {
        "command": "varro.chat.showFileDiffs",
        "title": "Varro: Show File Diffs",
        "shortTitle": "Show File Diffs",
        "icon": "$(diff-single)"
      },
      {
        "command": "varro.chat.hideFileDiffs",
        "title": "Varro: Hide File Diffs",
        "shortTitle": "Hide File Diffs",
        "icon": "$(list-flat)"
      },
      {
        "command": "varro.chat.openStats",
        "title": "Varro: Usage Stats",
        "shortTitle": "Usage Stats"
      },
      {
        "command": "varro.chat.openSkillSettings",
        "title": "Varro: Manage Skills",
        "shortTitle": "Manage Skills"
      },
      {
        "command": "varro.chat.openMcpSettings",
        "title": "Varro: Manage MCPs",
        "shortTitle": "Manage MCPs"
      },
      {
        "command": "varro.chat.openOpenCodeConfig",
        "title": "Varro: Open Global OpenCode Config",
        "shortTitle": "OpenCode.json"
      },
      {
        "command": "varro.chat.exportUsageCsv",
        "title": "Varro: Export All-Time Usage to CSV"
      },
      {
        "command": "varro.chat.deleteOldSessions",
        "title": "Varro: Delete Old OpenCode Sessions"
      },
      {
        "command": "varro.database.compact",
        "title": "Varro: Compact OpenCode Database"
      },
      {
        "command": "varro.chat.abort",
        "title": "Varro: Abort Session",
        "enablement": "varro:canAbortSession"
      },
      {
        "command": "varro.chat.previousSession",
        "title": "Varro: Previous Session",
        "enablement": "varro:canSwitchSessions"
      },
      {
        "command": "varro.chat.nextSession",
        "title": "Varro: Next Session",
        "enablement": "varro:canSwitchSessions"
      },
      {
        "command": "varro.chat.navigateBack",
        "title": "Varro: Go Back in Session History",
        "enablement": "varro:canNavigateBack"
      },
      {
        "command": "varro.chat.navigateForward",
        "title": "Varro: Go Forward in Session History",
        "enablement": "varro:canNavigateForward"
      },
      {
        "command": "varro.server.restart",
        "title": "Varro: Restart Server"
      },
      {
        "command": "varro.about",
        "title": "Varro: About",
        "shortTitle": "About Varro"
      },
      {
        "command": "varro.openGitHub",
        "title": "Varro: Open GitHub",
        "shortTitle": "View on GitHub"
      },
      {
        "command": "varro.showOutput",
        "title": "Varro: Show Output"
      },
      {
        "command": "varro.openSourceControl",
        "title": "Varro: Open Source Control"
      },
      {
        "command": "varro.generateCommitMessage",
        "title": "Varro: Generate Commit Message",
        "icon": "$(wand)"
      },
      {
        "command": "varro.walkThroughChanges",
        "title": "Varro: Walk Through Changes",
        "icon": "$(list-ordered)"
      },
      {
        "command": "varro.cancelCommitMessage",
        "title": "Varro: Cancel Commit Message Generation",
        "icon": "$(debug-stop)",
        "enablement": "varro:generatingCommitMessage"
      },
      {
        "command": "varro.agents.openGlobal",
        "title": "Varro: Open Global AGENTS.md"
      },
      {
        "command": "varro.agents.initializeProject",
        "title": "Varro: Initialize Project AGENTS.md"
      },
      {
        "command": "varro.chat.addToContext",
        "title": "Varro: Add to Context"
      },
      {
        "command": "varro.chat.addProblemsToContext",
        "title": "Varro: Add to Context",
        "enablement": "config.varro.chat.autoAttachProblems"
      },
      {
        "command": "varro.chat.addSelectionToContext",
        "title": "Varro: Add to Context"
      },
      {
        "command": "varro.chat.addTerminalSelectionToContext",
        "title": "Varro: Add to Context"
      },
      {
        "command": "varro.chat.copyLinkText",
        "title": "Copy"
      },
      {
        "command": "varro.chat.copyLink",
        "title": "Copy link"
      },
      {
        "command": "varro.chat.copyPath",
        "title": "Copy path"
      }
    ],
    "submenus": [
      {
        "id": "varro.viewActions",
        "label": "More Actions",
        "icon": "$(more)"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "varro.chat.copyLinkText",
          "when": "(webviewId == varro.chat || webviewId == varro.editor) && varroLinkText",
          "group": "navigation@0"
        },
        {
          "command": "varro.chat.copyLink",
          "when": "(webviewId == varro.chat || webviewId == varro.editor) && webviewSection == varroExternalLink",
          "group": "navigation@1"
        },
        {
          "command": "varro.chat.copyPath",
          "when": "(webviewId == varro.chat || webviewId == varro.editor) && webviewSection == varroFileLink",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "varro.chat.newEditor",
          "when": "activeWebviewPanelId == varro.editor",
          "group": "navigation@1"
        },
        {
          "command": "varro.chat.newTerminalEditor",
          "when": "activeWebviewPanelId == varro.editor",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "varro.chat.addToContext",
          "group": "z_varro"
        }
      ],
      "editor/context": [
        {
          "command": "varro.chat.addSelectionToContext",
          "when": "editorHasSelection && !editorReadonly",
          "group": "z_varro"
        }
      ],
      "terminal/context": [
        {
          "command": "varro.chat.addTerminalSelectionToContext",
          "when": "terminalTextSelected",
          "group": "z_varro"
        }
      ],
      "scm/title": [
        {
          "command": "varro.generateCommitMessage",
          "when": "scmProvider == git && scmProviderRootUri not in varro:commitMessageGenerationRoots",
          "group": "navigation@99"
        },
        {
          "command": "varro.cancelCommitMessage",
          "when": "scmProvider == git && scmProviderRootUri in varro:commitMessageGenerationRoots",
          "group": "navigation@99"
        }
      ],
      "view/title": [
        {
          "command": "varro.chat.showFileDiffs",
          "when": "view == varro.chat && !varro:showFileDiffs",
          "group": "navigation@0"
        },
        {
          "command": "varro.chat.hideFileDiffs",
          "when": "view == varro.chat && varro:showFileDiffs",
          "group": "navigation@0"
        },
        {
          "command": "varro.chat.openSettings",
          "when": "view == varro.chat",
          "group": "navigation@1"
        },
        {
          "submenu": "varro.viewActions",
          "when": "view == varro.chat",
          "group": "navigation@2"
        }
      ],
      "varro.viewActions": [
        {
          "command": "varro.about",
          "group": "1_main@1"
        },
        {
          "command": "varro.chat.openStats",
          "group": "1_main@2"
        },
        {
          "command": "varro.chat.openSkillSettings",
          "group": "1_main@3"
        },
        {
          "command": "varro.chat.openMcpSettings",
          "group": "1_main@4"
        },
        {
          "command": "varro.chat.openOpenCodeConfig",
          "group": "1_main@5"
        },
        {
          "command": "varro.openGitHub",
          "group": "1_main@6"
        }
      ],
      "commandPalette": [
        {
          "command": "varro.chat.copyLinkText",
          "when": "false"
        },
        {
          "command": "varro.chat.copyLink",
          "when": "false"
        },
        {
          "command": "varro.chat.copyPath",
          "when": "false"
        },
        {
          "command": "varro.chat.addProblemsToContext",
          "when": "false"
        },
        {
          "command": "varro.chat.showFileDiffs",
          "when": "!varro:showFileDiffs"
        },
        {
          "command": "varro.chat.hideFileDiffs",
          "when": "varro:showFileDiffs"
        },
        {
          "command": "varro.chat.addToContext",
          "when": "editorIsOpen"
        },
        {
          "command": "varro.chat.addSelectionToContext",
          "when": "false"
        },
        {
          "command": "varro.chat.addTerminalSelectionToContext",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "varro.chat.addSelectionToContext",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "varro.chat.addToContext",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "!terminalFocus && !editorTextFocus"
      },
      {
        "command": "varro.chat.addTerminalSelectionToContext",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "terminalFocus && terminalTextSelected"
      },
      {
        "command": "varro.chat.navigateBack",
        "key": "alt+left",
        "mac": "ctrl+-",
        "when": "varro:focusedChatSurface == sidebar && varro:canNavigateBack"
      },
      {
        "command": "varro.chat.navigateForward",
        "key": "alt+right",
        "mac": "ctrl+shift+-",
        "when": "varro:focusedChatSurface == sidebar && varro:canNavigateForward"
      }
    ],
    "configuration": [
      {
        "id": "varro.chat",
        "order": 1,
        "title": "Chat",
        "properties": {
          "varro.chat.autoAttachActiveFile": {
            "order": 1,
            "type": "boolean",
            "default": true,
            "description": "Attach the active file or editor selection to your chat messages automatically. Files you attach yourself are always included."
          },
          "varro.chat.autoAttachProblems": {
            "order": 2,
            "type": "boolean",
            "default": false,
            "description": "Attach errors and warnings from the VS Code Problems panel to your chat messages."
          },
          "varro.chat.showFileDiffs": {
            "order": 3,
            "type": "boolean",
            "default": false,
            "description": "Show line-by-line edits in file change cards."
          },
          "varro.chat.expandThinking": {
            "order": 4,
            "type": "boolean",
            "default": false,
            "description": "Expand the model's thinking while it reasons. It collapses again when the turn finishes."
          },
          "varro.chat.remoteImages": {
            "order": 5,
            "type": "string",
            "scope": "application",
            "enum": [
              "off",
              "ask",
              "on"
            ],
            "enumDescriptions": [
              "Show the image description instead of the image.",
              "Show a placeholder with Load image and Load all buttons.",
              "Load images automatically as they scroll into view."
            ],
            "default": "ask",
            "markdownDescription": "How to show web images in chat responses. Images are downloaded without your cookies or credentials, but the image server can see your IP address."
          },
          "varro.chat.showChangedFiles": {
            "order": 6,
            "type": "boolean",
            "default": false,
            "description": "Show the changed files panel above the chat input."
          },
          "varro.chat.tabbedPanels": {
            "order": 7,
            "type": "boolean",
            "default": true,
            "description": "When three or more panels are open above the chat input (queue, goal, todos, background services, changed files), show them as tabs. Turn off to stack them instead."
          },
          "varro.chat.showTurnTimer": {
            "order": 8,
            "type": "boolean",
            "default": true,
            "description": "Show how long the current turn has been running next to the chat input."
          },
          "varro.chat.sessionsPaneSide": {
            "order": 9,
            "type": "string",
            "enum": [
              "left",
              "right"
            ],
            "default": "right",
            "markdownDescription": "Which side of the Varro chat view shows the sessions pane on wide screens."
          },
          "varro.chat.fontSize": {
            "order": 10,
            "type": [
              "number",
              "null"
            ],
            "minimum": 6,
            "maximum": 100,
            "default": null,
            "markdownDescription": "Font size for Varro chat text, for example `13.5`. Set to `null` to use VS Code's `chat.fontSize` setting."
          }
        }
      },
      {
        "id": "varro.permissions",
        "order": 2,
        "title": "Permissions",
        "properties": {
          "varro.permissions.defaultMode": {
            "order": 1,
            "type": "string",
            "enum": [
              "default",
              "auto",
              "full"
            ],
            "default": "auto",
            "markdownDescription": "Permission mode to use until you pick one in Varro. `default` follows your OpenCode permission rules, `auto` has a model review requests and approve safe ones, and `full` allows everything without asking. Workspace settings can only pick a stricter mode than your user setting."
          },
          "varro.permissions.approveModel": {
            "order": 2,
            "type": "string",
            "scope": "application",
            "default": "",
            "pattern": "^$|^[^/\\s]+/[^\\s]+$",
            "patternErrorMessage": "Use provider/model, or leave the setting empty.",
            "markdownDescription": "Model that reviews permission requests in Auto mode, as `provider/model`. If `#varro.permissions.decisionModel#` is set, this model only handles requests that model could not answer. Leave empty to let Varro pick one, or choose one in the Varro Models view."
          },
          "varro.permissions.decisionModel": {
            "order": 3,
            "type": "string",
            "scope": "application",
            "default": "",
            "pattern": "^$|^[^/\\s]+/[^\\s]+$",
            "patternErrorMessage": "Use provider/model, or leave the setting empty.",
            "markdownDescription": "Optional model that reviews permission requests in Auto mode before `#varro.permissions.approveModel#`, as `provider/model`. It approves only when confident and otherwise asks you. If it fails or times out, `#varro.permissions.approveModel#` reviews the request. For TypeSafe Jev, use `typesafe/jev-latest` and connect it with **Add decision model** in the Varro Models view menu, or set `TYPESAFE_API_KEY`. Other values use a decision model hosted by OpenCode (requires OpenCode 2.2.0). Permission details are sent to this model. Leave empty to turn it off."
          },
          "varro.permissions.onReject": {
            "order": 4,
            "type": "string",
            "scope": "application",
            "enum": [
              "default",
              "custom",
              "off"
            ],
            "markdownEnumDescriptions": [
              "Use Varro's guidance: don't work around a rejection, but follow an alternative you suggest.",
              "Use your own text from `#varro.permissions.onRejectCustom#`.",
              "Add no guidance."
            ],
            "default": "default",
            "markdownDescription": "System prompt guidance for when you reject a tool permission. With `off`, the model may try another way to reach the same result, though each attempt still asks for permission. You can also write your own policy in `AGENTS.md`. Changing this setting invalidates the prompt cache once."
          },
          "varro.permissions.onRejectCustom": {
            "order": 5,
            "type": "string",
            "scope": "application",
            "default": "",
            "editPresentation": "multilineText",
            "markdownDescription": "Your own guidance for rejected permissions, used when `#varro.permissions.onReject#` is `custom`. Leave empty to use Varro's built-in guidance."
          },
          "varro.chat.autoApproveModel": {
            "order": 6,
            "type": "string",
            "scope": "application",
            "pattern": "^$|^[^/\\s]+/[^\\s]+$",
            "default": "",
            "markdownDeprecationMessage": "Renamed to `#varro.permissions.approveModel#`. Varro moves a user setting to the new name when it starts, and reads this one only while the new setting is unset."
          }
        }
      },
      {
        "id": "varro.utilities",
        "order": 3,
        "title": "Utilities",
        "properties": {
          "varro.followups.enabled": {
            "order": 1,
            "type": "boolean",
            "scope": "application",
            "default": true,
            "markdownDescription": "Suggest next steps after Build responses. Requires OpenCode V2. Each suggestion is an extra model request, which can use paid tokens or subscription quota."
          },
          "varro.followups.model": {
            "order": 2,
            "type": "string",
            "scope": "application",
            "default": "",
            "pattern": "^$|^[^/\\s]+/[^\\s]+$",
            "patternErrorMessage": "Use provider/model, or leave the setting empty.",
            "markdownDescription": "Model for suggested next steps, as `provider/model`. Leave empty to use the session's model, or choose one with **Use for follow-ups** in the Varro Models view."
          },
          "varro.promptCompletion.model": {
            "order": 3,
            "type": "string",
            "scope": "application",
            "default": "",
            "pattern": "^$|^[^/\\s]+/[^\\s]+$",
            "patternErrorMessage": "Use provider/model, or leave the setting empty.",
            "markdownDescription": "Model that suggests how to finish the prompt you are typing, as `provider/model`. Leave empty to turn suggestions off. Requires OpenCode V2 and a provider connected with an API key; subscription logins are not supported. Your draft and recent prompts are sent to this model. Pick a fast model in the Varro Models view. Press Tab to accept a suggestion or Escape to dismiss it.",
            "tags": [
              "advanced"
            ]
          },
          "varro.commitMessage.model": {
            "order": 4,
            "type": "string",
            "scope": "application",
            "default": "",
            "pattern": "^$|^[^/\\s]+/[^\\s]+$",
            "patternErrorMessage": "Use provider/model, or leave the setting empty.",
            "markdownDescription": "Model for generating commit messages, as `provider/model`. Leave empty to let Varro pick one, or choose one in the Varro Models view."
          },
          "varro.commitMessage.rules": {
            "order": 5,
            "type": "string",
            "scope": "resource",
            "default": "",
            "markdownDescription": "Style rules for generated commit messages, for example `Use Conventional Commits with a scope.` Workspace and folder settings override your user setting for that repository."
          },
          "varro.walkthrough.model": {
            "order": 6,
            "type": "string",
            "scope": "application",
            "default": "",
            "pattern": "^$|^[^/\\s]+/[^\\s]+$",
            "patternErrorMessage": "Use provider/model or provider/model#variant, or leave the setting empty.",
            "markdownDescription": "Model for changes walkthroughs, as `provider/model`, or `provider/model#variant` to set the reasoning level. Leave empty to use the current chat's model, or choose one with **Use for reviews** in the Varro Models view."
          },
          "varro.promptTracing.enabled": {
            "order": 7,
            "type": "boolean",
            "scope": "application",
            "default": false,
            "markdownDescription": "For usage-tracking proxies: add a `VARRO_TRACE_V1` line to Varro's background model requests, such as follow-ups, permission reviews, commit messages, titles, and walkthroughs. The line identifies the request's purpose and session. Your proxy must remove it before the request reaches the model. Leave off unless you run such a proxy."
          },
          "varro.chat.fallbackTitle": {
            "order": 8,
            "type": "boolean",
            "default": false,
            "markdownDescription": "Have Varro generate a title when OpenCode leaves a session untitled.",
            "tags": [
              "advanced"
            ]
          }
        }
      },
      {
        "id": "varro.notifications",
        "order": 4,
        "title": "Notifications",
        "properties": {
          "varro.notifications.native": {
            "order": 1,
            "type": "boolean",
            "scope": "application",
            "default": false,
            "markdownDescription": "Show system notifications for finished replies, plans ready for review, permission requests, and questions when their VS Code window is not focused. Set sounds in `#varro.notifications.sound#`. Not available in remote windows. Your OS must allow notifications from VS Code. On Linux, install `notify-send`."
          },
          "varro.notifications.sound": {
            "order": 2,
            "type": "object",
            "scope": "application",
            "additionalProperties": false,
            "properties": {
              "permission": {
                "type": "boolean",
                "description": "Permission requests, including requests from subagents.",
                "default": false
              },
              "question": {
                "type": "boolean",
                "description": "Questions that need your answer.",
                "default": false
              },
              "completed": {
                "type": "boolean",
                "description": "Completed replies in non-plan conversations.",
                "default": false
              },
              "planReady": {
                "type": "boolean",
                "description": "Plans ready for review.",
                "default": false
              }
            },
            "default": {
              "permission": false,
              "question": false,
              "completed": false,
              "planReady": false
            },
            "markdownDescription": "Events that play a sound when their VS Code window is not focused. Not available in remote windows. On Linux, install `paplay`, `aplay`, or `canberra-gtk-play`."
          }
        }
      },
      {
        "id": "varro.usage",
        "order": 5,
        "title": "Usage and Limits",
        "properties": {
          "varro.providerLimits.statusBar": {
            "order": 1,
            "type": "string",
            "enum": [
              "rotating",
              "all"
            ],
            "enumDescriptions": [
              "Show one provider at a time, switching every 15 seconds.",
              "Show all pinned providers at once."
            ],
            "default": "rotating",
            "description": "How pinned provider limits appear in the status bar. Providers used by chats in this window are left out. Hover for details."
          },
          "varro.chat.cacheWarningTokens": {
            "order": 2,
            "type": "integer",
            "minimum": 0,
            "default": 300000,
            "markdownDescription": "Warn when an idle session with at least this many context tokens has likely lost its prompt cache, so the next message will cost more. Set to `0` to turn the warning off."
          },
          "varro.usageReports.showCacheWrite": {
            "order": 3,
            "type": "boolean",
            "default": false,
            "description": "Show cache write tokens in their own column in usage reports. When off, they are counted in the Input column."
          }
        }
      },
      {
        "id": "varro.server",
        "order": 6,
        "title": "OpenCode CLI and Server",
        "properties": {
          "varro.server.command": {
            "order": 1,
            "type": "string",
            "default": "",
            "description": "Path to the OpenCode CLI. Leave empty to find opencode2, then opencode. Set a path to use a specific version, such as OpenCode v1. Only user and remote settings apply."
          },
          "varro.server.autoUpdate": {
            "order": 2,
            "type": "boolean",
            "default": true,
            "description": "Keep the OpenCode CLI up to date. Updates stay on the installed major version, so v1 is never upgraded to v2. On Windows, v1 shows an update prompt instead."
          },
          "varro.server.autoStart": {
            "order": 3,
            "type": "boolean",
            "default": true,
            "description": "Start the OpenCode server when Varro needs it. Turn off if you run the server yourself, for example in Docker or through a tunnel. Some CLI and server configuration actions are then unavailable."
          },
          "varro.server.port": {
            "order": 4,
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 65535,
            "default": null,
            "markdownDescription": "Port for the local OpenCode server, from 1 to 65535. Leave empty to let Varro choose one. Varro uses only this port when set. Reload the window after changing it."
          }
        }
      },
      {
        "id": "varro.debug",
        "order": 7,
        "title": "Debug",
        "properties": {
          "varro.debug.simulateMissingCli": {
            "order": 1,
            "type": "boolean",
            "default": false,
            "tags": [
              "advanced"
            ],
            "description": "Debug only: act as if the OpenCode CLI is not installed."
          },
          "varro.debug.simulateNoProviders": {
            "order": 2,
            "type": "boolean",
            "default": false,
            "tags": [
              "advanced"
            ],
            "description": "Debug only: act as if no providers are configured."
          },
          "varro.debug.simulateUpgradeFailure": {
            "order": 3,
            "type": "string",
            "default": "",
            "tags": [
              "advanced"
            ],
            "description": "Debug only: make OpenCode CLI updates fail with this error text, for example \"EPERM: operation not permitted\"."
          },
          "varro.debug.showQuotaWarning": {
            "order": 4,
            "type": "boolean",
            "default": false,
            "tags": [
              "advanced"
            ],
            "description": "Debug only: always show the quota warning, ignoring remaining allowance and dismissals. Closing it here is not saved."
          },
          "varro.debug.resetWarningDays": {
            "order": 5,
            "type": "integer",
            "minimum": 5,
            "default": 5,
            "tags": [
              "advanced"
            ],
            "markdownDescription": "Debug only: show a usage reset warning this many days before the reset. Dismissed warnings stay hidden unless `#varro.debug.showQuotaWarning#` is on."
          },
          "varro.debug.showDecisionModels": {
            "order": 6,
            "type": "boolean",
            "scope": "application",
            "default": false,
            "tags": [
              "advanced"
            ],
            "description": "Debug only: show the experimental decision model section in the Models view. Hiding it does not turn off a configured decision model."
          }
        }
      }
    ]
  },
  "activationEvents": [
    "onCommand:varro.chat.focus",
    "onCommand:varro.chat.statusBarClick",
    "onUri",
    "onWebviewPanel:varro.editor"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#232323",
    "theme": "dark"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "vscode": "^1.107.0"
  },
  "volta": {
    "node": "24.22.3",
    "npm": "12.2.3"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Varro starts a local OpenCode process and grants it access to the workspace."
    }
  }
}

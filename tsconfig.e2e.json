{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist/e2e",
    "rootDir": ".",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["e2e/**/*", "playwright.config.ts", "src/webview/**/*", "src/shared/**/*"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test-support.ts",
    "src/**/*.test-support.tsx",
    "src/test/**/*",
    "src/webview/perf/harness.ts"
  ]
}

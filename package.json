{
  "name": "varro",
  "displayName": "Varro: OpenCode Workbench",
  "version": "0.27.0",
  "description": "OpenCode agent workbench with project-aware chat, parallel sessions, plan and change review, model and permission controls, commit messages, and usage insights.",
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "agentic-coding",
    "ai",
    "chat",
    "coding-agent",
    "commit-message",
    "opencode",
    "opencode-gui"
  ],
  "homepage": "https://github.com/koltyakov/varro#readme",
  "bugs": {
    "url": "https://github.com/koltyakov/varro/issues"
  },
  "license": "MIT",
  "repository": "https://github.com/koltyakov/varro",
  "publisher": "koltyakov",
  "files": [
    "dist/extension/extension.js",
    "dist/webview",
    "assets/icon.png",
    "README.md",
    "CHANGELOG.md",
    "NOTICES.md",
    "LICENSE"
  ],
  "main": "./dist/extension/extension.js",
  "scripts": {
    "postinstall": "node scripts/build-anti-slop-plugin.mjs",
    "build:extension": "node esbuild.config.mjs",
    "build:webview": "vite build",
    "preview:webview": "vite --open /preview.html",
    "build": "npm run build:extension && npm run build:webview",
    "watch:extension": "node esbuild.config.mjs --watch",
    "watch:webview": "vite build --watch",
    "dev": "npx concurrently --kill-others-on-fail --names ext,web,preview \"npm run watch:extension\" \"npm run watch:webview\" \"npm run preview:webview\"",
    "lint": "oxlint -c oxlint.config.mts . --fix",
    "lint:check": "oxlint -c oxlint.config.mts .",
    "fmt": "oxfmt src/",
    "test": "node scripts/run-tests.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:compatibility": "node scripts/opencode-compatibility/run.mjs --check-floor --report artifacts/opencode-compatibility.json --summary scripts/opencode-compatibility/verified.json",
    "compatibility:discover": "node scripts/opencode-compatibility/run.mjs --report artifacts/opencode-compatibility.json",
    "test:e2e": "playwright test",
    "test:vscode-sandbox": "npm run build && node scripts/vscode-sandbox/run.mjs",
    "ai:vscode": "npm run build && node scripts/launch-ai-vscode.mjs",
    "ai:preconditions": "node scripts/ai-fuzzy-preconditions.mjs",
    "ai:live": "node scripts/ai-fuzzy-live.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:suggestions": "node scripts/check-ts-suggestions.mjs",
    "package:vsix": "node scripts/package-vsix.mjs",
    "package": "npm run build && npm run package:vsix",
    "vscode:install": "node scripts/vscode-install.mjs"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.23",
    "dompurify": "^3.4.14",
    "highlight.js": "11.12.0",
    "jsonc-parser": "^3.3.1",
    "marked": "18.0.11",
    "mermaid": "^11.17.2",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/css.escape": "1.5.2",
    "@types/node": "26.4.0",
    "@types/vscode": "1.120.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vscode/vsce": "3.9.2",
    "cross-spawn": "7.0.6",
    "css.escape": "1.5.1",
    "esbuild": "0.28.2",
    "iconoir": "^7.12.1",
    "jsdom": "30.0.1",
    "material-icon-theme": "^5.38.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-plugin-anti-slop": "github:dmmulroy/anti-slop",
    "rolldown": "1.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.11"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "varro-primary",
          "title": "Varro",
          "icon": "assets/icon.png"
        }
      ],
      "secondarySidebar": [
        {
          "id": "varro",
          "title": "Varro",
          "icon": "assets/icon.png"
        }
      ]
    },
    "views": {
      "varro": [
        {
          "icon": "assets/icon.png",
          "type": "webview",
          "id": "varro.chat",
          "name": "Varro"
        }
      ]
    },
    "commands": [
      {
        "command": "varro.chat.newSession",
        "title": "Varro: New Session"
      },
      {
        "command": "varro.chat.newEditor",
        "title": "Varro: New Chat Editor",
        "shortTitle": "New Chat Editor",
        "icon": "$(add)"
      },
      {
        "command": "varro.chat.newTerminalEditor",
        "title": "Varro: New Terminal Editor",
        "shortTitle": "New Terminal Editor",
        "icon": "$(terminal)"
      },
      {
        "command": "varro.chat.searchSessions",
        "title": "Varro: Search Sessions"
      },
      {
        "command": "varro.chat.openSettings",
        "title": "Varro: Open Settings",
        "shortTitle": "Settings",
        "icon": "$(gear)"
      },
      {
        "command": "varro.chat.showFileDiffs",
        "title": "Varro: Show File Diffs",
        "shortTitle": "Show File Diffs",
        "icon": "$(diff-single)"
      },
      {
        "command": "varro.chat.hideFileDiffs",
        "title": "Varro: Hide File Diffs",
        "shortTitle": "Hide File Diffs",
        "icon": "$(list-flat)"
      },
      {
        "command": "varro.chat.openStats",
        "title": "Varro: Usage Stats",
        "shortTitle": "Usage Stats"
      },
      {
        "command": "varro.chat.abort",
        "title": "Varro: Abort Session",
        "enablement": "varro:canAbortSession"
      },
      {
        "command": "varro.chat.previousSession",
        "title": "Varro: Previous Session",
        "enablement": "varro:canSwitchSessions"
      },
      {
        "command": "varro.chat.nextSession",
        "title": "Varro: Next Session",
        "enablement": "varro:canSwitchSessions"
      },
      {
        "command": "varro.server.restart",
        "title": "Varro: Restart Server"
      },
      {
        "command": "varro.about",
        "title": "Varro: About",
        "shortTitle": "About Varro"
      },
      {
        "command": "varro.openGitHub",
        "title": "Varro: Open GitHub",
        "shortTitle": "View on GitHub"
      },
      {
        "command": "varro.showOutput",
        "title": "Varro: Show Output"
      },
      {
        "command": "varro.openSourceControl",
        "title": "Varro: Open Source Control"
      },
      {
        "command": "varro.generateCommitMessage",
        "title": "Varro: Generate Commit Message",
        "icon": "$(wand)"
      },
      {
        "command": "varro.agents.openGlobal",
        "title": "Varro: Open Global AGENTS.md"
      },
      {
        "command": "varro.agents.initializeProject",
        "title": "Varro: Initialize Project AGENTS.md"
      },
      {
        "command": "varro.chat.addToContext",
        "title": "Varro: Add to Context"
      },
      {
        "command": "varro.chat.addSelectionToContext",
        "title": "Varro: Add to Context"
      },
      {
        "command": "varro.chat.addTerminalSelectionToContext",
        "title": "Varro: Add to Context"
      }
    ],
    "submenus": [
      {
        "id": "varro.viewActions",
        "label": "More Actions",
        "icon": "$(more)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "varro.chat.newEditor",
          "when": "activeWebviewPanelId == varro.editor",
          "group": "navigation@1"
        },
        {
          "command": "varro.chat.newTerminalEditor",
          "when": "activeWebviewPanelId == varro.editor",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "varro.chat.addToContext",
          "group": "z_varro"
        }
      ],
      "editor/context": [
        {
          "command": "varro.chat.addSelectionToContext",
          "when": "editorHasSelection && !editorReadonly",
          "group": "z_varro"
        }
      ],
      "terminal/context": [
        {
          "command": "varro.chat.addTerminalSelectionToContext",
          "when": "terminalTextSelected",
          "group": "z_varro"
        }
      ],
      "scm/title": [
        {
          "command": "varro.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation@99"
        }
      ],
      "view/title": [
        {
          "command": "varro.chat.showFileDiffs",
          "when": "view == varro.chat && !varro:showFileDiffs",
          "group": "navigation@0"
        },
        {
          "command": "varro.chat.hideFileDiffs",
          "when": "view == varro.chat && varro:showFileDiffs",
          "group": "navigation@0"
        },
        {
          "command": "varro.chat.openSettings",
          "when": "view == varro.chat",
          "group": "navigation@1"
        },
        {
          "submenu": "varro.viewActions",
          "when": "view == varro.chat",
          "group": "navigation@2"
        }
      ],
      "varro.viewActions": [
        {
          "command": "varro.about",
          "group": "1_main@1"
        },
        {
          "command": "varro.chat.openStats",
          "group": "1_main@2"
        },
        {
          "command": "varro.openGitHub",
          "group": "1_main@3"
        }
      ],
      "commandPalette": [
        {
          "command": "varro.chat.showFileDiffs",
          "when": "!varro:showFileDiffs"
        },
        {
          "command": "varro.chat.hideFileDiffs",
          "when": "varro:showFileDiffs"
        },
        {
          "command": "varro.chat.addToContext",
          "when": "editorIsOpen"
        },
        {
          "command": "varro.chat.addSelectionToContext",
          "when": "false"
        },
        {
          "command": "varro.chat.addTerminalSelectionToContext",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "varro.chat.addSelectionToContext",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "varro.chat.addToContext",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "!terminalFocus && !editorTextFocus"
      },
      {
        "command": "varro.chat.addTerminalSelectionToContext",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "terminalFocus"
      }
    ],
    "configuration": {
      "title": "Varro",
      "properties": {
        "varro.server.port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 4096,
          "markdownDescription": "Port for the OpenCode server. Reload the VS Code window after changing this setting."
        },
        "varro.server.command": {
          "type": "string",
          "default": "",
          "description": "Optional path to the OpenCode CLI executable Varro uses for server startup and other CLI-backed actions"
        },
        "varro.server.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically install OpenCode CLI updates only through the OpenCode version declared in Varro's manifest"
        },
        "varro.chat.showFileDiffs": {
          "type": "boolean",
          "default": false,
          "description": "Show line-by-line edits directly in file-change tool cards."
        },
        "varro.chat.expandThinking": {
          "type": "boolean",
          "default": false,
          "description": "Expand thinking details after two seconds while reasoning is active, collapse finished thinking into rows, and return it to Explored when the turn finishes."
        },
        "varro.chat.fontSize": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 6,
          "maximum": 100,
          "default": null,
          "markdownDescription": "Font size for text in Varro chat. Set to `null` to use the VS Code `chat.fontSize` setting, or use `13.5` for text slightly larger than the default."
        },
        "varro.chat.showChangedFiles": {
          "type": "boolean",
          "default": false,
          "description": "Show the changed-files panel above the chat input."
        },
        "varro.chat.desktopSessionPaneSide": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "right",
          "markdownDescription": "Choose which side shows the sessions pane on large screens in the Varro chat view."
        },
        "varro.chat.defaultPermissionMode": {
          "type": "string",
          "enum": [
            "default",
            "edits",
            "auto",
            "full"
          ],
          "default": "auto",
          "markdownDescription": "Permission mode selected when no project or global Varro permission-mode selection has been saved. `default` follows OpenCode permission settings and shows requests OpenCode asks about, `edits` accepts file edits while asking before other actions, `auto` judges eligible requests automatically, and `full` grants unrestricted access."
        },
        "varro.chat.autoApproveModel": {
          "type": "string",
          "scope": "application",
          "default": "",
          "pattern": "^$|^[^/\\s]+/[^\\s]+$",
          "patternErrorMessage": "Use provider/model, or leave the setting empty.",
          "markdownDescription": "Provider/model used by the auto-approve judge. Leave empty to let Varro select a suitable model automatically. Select a configured model from Varro's Models view."
        },
        "varro.chat.autoRenameUntitledSessions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Let Varro generate a fallback title when OpenCode leaves a session untitled. Disable this to rely only on OpenCode's native session naming."
        },
        "varro.chat.autoCompact": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic OpenCode session compaction when context is full. Project opencode.json overrides this setting."
        },
        "varro.chat.autoCompactionReservedTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "default": 4096,
          "description": "Reserved token headroom before automatic OpenCode compaction triggers. Lower values compact later. Set to null to use OpenCode defaults. Project opencode.json overrides this setting."
        },
        "varro.commitMessage.model": {
          "type": "string",
          "scope": "application",
          "default": "",
          "pattern": "^$|^[^/\\s]+/[^\\s]+$",
          "patternErrorMessage": "Use provider/model, or leave the setting empty.",
          "markdownDescription": "Provider/model used to generate commit messages. Leave empty to let Varro select a suitable model automatically. Select a configured model from Varro's Models view."
        },
        "varro.debug.simulateMissingCli": {
          "deprecationMessage": "Debug only setting. Not intended for regular use.",
          "type": "boolean",
          "default": false,
          "description": "Debug only: make Varro behave as if the OpenCode CLI is not installed"
        },
        "varro.debug.simulateNoProviders": {
          "deprecationMessage": "Debug only setting. Not intended for regular use.",
          "type": "boolean",
          "default": false,
          "description": "Debug only: make Varro behave as if no providers are configured"
        },
        "varro.debug.simulateUpgradeFailure": {
          "deprecationMessage": "Debug only setting. Not intended for regular use.",
          "type": "string",
          "default": "",
          "description": "Debug only: make OpenCode CLI updates fail with this error text, to exercise the update recovery guidance (for example \"EPERM: operation not permitted\")"
        },
        "varro.debug.suggestUntestedOpenCodeUpdates": {
          "deprecationMessage": "Debug only setting. Not intended for regular use.",
          "type": "boolean",
          "default": false,
          "description": "Debug only: suggest OpenCode CLI versions newer than the version declared in Varro's manifest. These versions are never installed automatically"
        },
        "varro.server.autoStart": {
          "deprecationMessage": "Debug only setting. Not intended for regular use.",
          "type": "boolean",
          "default": true,
          "description": "Automatically start the OpenCode server when Varro first needs it"
        }
      }
    }
  },
  "activationEvents": [
    "onCommand:varro.chat.focus",
    "onCommand:varro.chat.statusBarClick",
    "onStartupFinished",
    "onWebviewPanel:varro.editor"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#24160f",
    "theme": "dark"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "vscode": "^1.120.0"
  },
  "volta": {
    "node": "24.16.0",
    "npm": "10.9.8"
  },
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Varro starts a local OpenCode process and grants it access to the workspace."
    }
  }
}

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist/extension",
    "types": ["vscode", "node"],
    "lib": ["ES2023"]
  },
  "include": ["src/extension/**/*", "src/shared/**/*"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test-support.ts",
    "src/**/*.test-support.tsx",
    "src/test/**/*",
    "src/webview/perf/harness.ts"
  ]
}
